# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ISSUER=dummyjson-sync
JWT_ACCESS_TOKEN_MINUTES=30

# Docker Compose internal database. Change credentials before deployment.
POSTGRES_DB=dummyjson
POSTGRES_USER=dummyjson_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://dummyjson_app:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/dummyjson
# Only for compose.external-db.yaml: existing external Docker network name
DATABASE_DOCKER_NETWORK=dummyjson-shared

# Optional one-time bootstrap admin. Leave both empty to disable bootstrap.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

DUMMYJSON_BASE_URL=https://dummyjson.com
DUMMYJSON_TIMEOUT_SECONDS=20
SYNC_PAGE_SIZE=100
LOG_LEVEL=INFO

